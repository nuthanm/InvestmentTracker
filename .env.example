# Copy this file to .env.local and fill in your Neon database URL.
# Get it from https://console.neon.tech > Project > Connection Details > Pooled connection
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Random secret used to sign session tokens. Generate with OpenSSL, Node, or PowerShell (see README).
SESSION_SECRET=replace-me-with-a-long-random-string
